# 禾目 AgriGuard 环境变量模板
#
# 使用方法：
#   1) 把本文件复制为 .env（同目录）
#   2) 把 LLM_API_KEY 换成你自己的真实密钥
#   3) 重启服务
#
# ⚠️ 重要：
#   - .env 已被 .gitignore 忽略，切勿提交到公开仓库。
#   - 若保留了下面的示例占位值（含 "your-key" 字样）或密钥长度不足，
#     程序会识别为「未配置」，直接走内置模板处方，
#     不会发起网络请求 —— 这是为了避免误把示例值当真实密钥，
#     导致每次请求都等满超时（现场演示的致命事故）。

# 大模型处方总开关。设为 0 / false / no / off 可关闭（处方回落到内置模板）。
# 关闭后不再发起任何网络请求，功能完整，只是处方不个性化。
# 注意：**即使此开关为开，若 LLM_API_KEY 无效（占位符或过短）也不会发起请求**，
#       会直接走模板 —— 这是防止误用示例值导致每次请求都等满超时的保护。
LLM_ENABLED=true

# 通义千问 / 阿里云百炼（DashScope 兼容 OpenAI 协议）
# 获取地址：https://bailian.console.aliyun.com/
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 大模型调用超时（秒）。断网时按这两项上限返回，不会长时间挂起。
# 连接超时保持较小，避免网络不通时拖住请求线程。
LLM_CONNECT_TIMEOUT=3.5
LLM_READ_TIMEOUT=12

# ---------------------------------------------------------------------------
# SQLite 库文件位置（可选）
# ---------------------------------------------------------------------------
# 什么时候需要设它：
#   - 想把演示库放到别处（例如放到临时盘、演示 U 盘）；
#   - 给每个环境一个独立的库文件，互不污染（本地开发 / 现场演示 / 自动化测试）；
#     测试时指向临时文件即可，不必去动默认库，也不会污染真实历史数据。
#
# 不设置时使用默认值，行为完全不变：data/agriguard.db
#   （data/ 已被 .gitignore 忽略，里面的库不会进版本控制）
# 支持 ~ 展开；相对路径按「当前工作目录」解析；
# 父目录不存在时会自动创建，不会导致服务起不来。
#
# 优先级：真实环境变量 > 本文件（config.py 用 load_dotenv(override=False)，
#        已存在的环境变量不会被 .env 覆盖）。
#
# 示例：
# AGRI_DB_PATH=D:/tmp/agriguard-demo/agriguard.db
